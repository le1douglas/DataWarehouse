{
    "python.terminal.useEnvFile": true,
    // the python path of the code, for pylance:
    // - airflow puts the dags folder on it, so the dags import utils/ from it
    // - PYTHONPATH of the images has python/src, so the web apps import webapps from it
    "python.analysis.extraPaths": [
        "airflow/dags",
        "python/src"
    ],
    "dbt.perspectiveTheme": "Vintage"
}
