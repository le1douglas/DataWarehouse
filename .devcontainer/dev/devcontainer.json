// the dev container: every tool of the three images at the same versions, plus the dev tools and Claude Code
// open with "Dev Containers: Reopen in Container"
{
  "name": "dev",
  // relative to this file. compose.dev.yaml sets the project name, the mounts and the env vars
  "dockerComposeFile": ["../../docker/compose.yaml", "../../docker/compose.dev.yaml"],
  "service": "dev",
  // only this service, and postgres through depends_on
  "runServices": ["dev"],
  // fixed: Claude Code files its memory under this path, so a new path starts an empty memory
  "workspaceFolder": "/usr/app",
  "overrideCommand": true,
  // closing the window leaves the containers running: postgres is shared with Excel
  "shutdownAction": "none",
  // the diagram's server (dbterd.serverPort): its tab runs in VS Code on windows and reaches it only through this
  // forward. 8080/8081 and 5432/5433 are taken by NiceGUI and postgres
  "forwardPorts": [8790],
  // Claude Code's command line needs node
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    // for the PowerShell extension below. the .ps1 scripts still run on windows
    "ghcr.io/devcontainers/features/powershell:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // python, and pytest in the testing panel. dbt Power User needs it too
        "ms-python.python",
        "charliermarsh.ruff",
        // dbt, and the colours of the jinja in the sql
        "innoverio.vscode-dbt-power-user",
        "samuelcolvin.jinjahtml",
        // lints and formats the dbt sql with sqlfluff (.sqlfluff): dbt Power User formats only with sqlfmt
        "sqlfluff.vscode-sqlfluff",
        // the entity relationship diagram of the dbt models
        "datnguye.dbterd-vscode",
        // meltano.yml
        "redhat.vscode-yaml",
        // the database in a sidebar. backup and restore use the dev stage's pg_dump and pg_restore
        "cweijan.vscode-postgresql-client2",
        // csv files as a table
        "ReprEng.csv",
        // the .ps1 scripts of docker/: syntax, completion and analysis. needs pwsh, from the feature above
        "ms-vscode.PowerShell",
        "anthropic.claude-code"
      ],
      "settings": {
        // keep the image's C.UTF-8: the terminal's default en_US.UTF-8 is not in the image, and perl (psql's wrapper)
        // warns about it on every call
        "terminal.integrated.detectLocale": "off",
        // the web apps' python, where pytest is. dbt Power User uses the dbt venv's python instead
        "python.defaultInterpreterPath": "/opt/venvs/webapps/bin/python",
        "dbt.dbtPythonPathOverride": "/opt/venvs/dbt/bin/python",
        "dbt.perspectiveTheme": "Vintage",
        "dbt.lineage.defaultExpansion": 13,
        // the diagram reads <this path>/target, refreshed by
        //   dbt docs generate --target-path $DBT_METADATA_EXPORT_DIR/target --log-path $DBT_METADATA_EXPORT_DIR/logs
        // - not the project, so clicking a model does not open its .sql file
        // - the extension makes its server's venv on first use, and again after a container rebuild
        "dbterd.dbtProjectPath": "/dbt-state/metadata-export",
        // fixed, for forwardPorts above: 0 would pick a new one on every restart, and the forward would not follow
        "dbterd.serverPort": 8790,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["python/tests"],
        // the ruff of docker/pipeline/requirements-tools.txt, not the one bundled with the extension
        "ruff.path": ["/opt/venvs/tools/bin/ruff"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        // the sqlfluff of docker/pipeline/requirements-tools.txt, the formatter of the dbt sql instead of dbt Power User
        // - executeInTerminal: the extension formats with the dbt templater only this way (experimental)
        // - lint on save, not on type: the dbt templater compiles the model against the database on every run
        "sqlfluff.executablePath": "/opt/venvs/tools/bin/sqlfluff",
        "sqlfluff.experimental.format.executeInTerminal": true,
        "sqlfluff.linter.run": "onSave",
        "sqlfluff.linter.diagnosticSeverity": "hint",
        "[jinja-sql]": {
          "editor.defaultFormatter": "sqlfluff.vscode-sqlfluff"
        },
        // meltano.yml's schema, at the version in requirements-meltano.txt: change both together
        "yaml.schemas": {
          "https://raw.githubusercontent.com/meltano/meltano/v4.4.1/src/meltano/schemas/meltano.schema.json": "meltano/meltano.yml"
        }
      }
    }
  }
}
