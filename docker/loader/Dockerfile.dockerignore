# build context of the loader image (the repo root): only the python package and the dbt project go in.
# paths are relative to the repo root, not to this file
*
!src
!DataWarehouseDbt

# written by python and pip on Windows
**/__pycache__
src/*.egg-info

# written by dbt on Windows, as in the dbt image: the image runs dbt deps itself, target/ and logs/ are written at run time
DataWarehouseDbt/target
DataWarehouseDbt/logs
DataWarehouseDbt/dbt_packages

# the datastreamer has its own image (docker/datastreamer)
src/bluelab_datastreamer
