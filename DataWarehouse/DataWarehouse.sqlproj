<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.1.0" />
  <PropertyGroup>
    <Name>datawarehouse</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql170DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>bf10f72c-5262-47d5-b2d1-da049c4c5f1c</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="PostDeploymentScript.sql" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="dbo\Functions\" />
    <Folder Include="dbo\Security\" />
    <Folder Include="dbo\StoredProcedures\" />
    <Folder Include="dbo\Tables\" />
    <Folder Include="dbo\UserDefinedTypes\" />
    <Folder Include="dbo\Views\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="DataWarehouse.Environment.publish.xml" />
  </ItemGroup>
  <ItemGroup>
    <PostDeploy Include="PostDeploymentScript.sql" />
  </ItemGroup>
</Project>
